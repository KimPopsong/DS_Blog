---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`404 - 페이지를 찾을 수 없습니다 | ${SITE_TITLE}`} description="요청하신 페이지를 찾을 수 없습니다." />
		<style>
			main {
				max-width: 1400px;
				width: 100%;
				margin: 0 auto;
				padding: 4em 2em;
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				min-height: 60vh;
			}
			.error-container {
				text-align: left;
				max-width: 520px;
				width: 100%;
				background: var(--card-bg);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				padding: 2rem 2.25rem;
				font-family: var(--font-mono);
			}
			.error-line {
				margin: 0 0 0.5rem 0;
			}
			.error-prompt {
				color: var(--accent);
				margin-right: 0.6em;
			}
			.error-code {
				font-size: 1.05rem;
				font-weight: 600;
				margin: 0 0 1.25rem 0;
				color: rgb(var(--black));
				line-height: 1.6;
			}
			.error-title {
				font-size: 1.05rem;
				font-weight: 400;
				margin: 0 0 1.25rem 0;
				color: rgb(var(--gray-dark));
			}
			.error-description {
				font-size: 0.95rem;
				color: rgb(var(--gray));
				margin-bottom: 2rem;
				line-height: 1.7;
			}
			.home-button {
				display: inline-block;
				padding: 0.7rem 1.5rem;
				background: transparent;
				border: 1px solid var(--accent);
				border-radius: 6px;
				color: var(--accent);
				text-decoration: none;
				font-weight: 500;
				font-size: 0.9rem;
				transition: background-color 0.2s ease, color 0.2s ease;
			}
			.home-button:hover {
				background: var(--accent);
				color: var(--bg);
			}
			@media (max-width: 720px) {
				main {
					padding: 2em 1em;
				}
				.error-container {
					padding: 1.5rem 1.5rem;
				}
				.error-code {
					font-size: 0.85rem;
				}
				.home-button {
					width: 100%;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="error-container">
				<p class="error-line"><span class="error-prompt">$</span>cd {Astro.url.pathname}</p>
				<h1 class="error-code">-bash: cd: {Astro.url.pathname}: No such file or directory</h1>
				<h2 class="error-title">404 — 페이지를 찾을 수 없습니다</h2>
				<p class="error-description">
					요청하신 페이지가 존재하지 않거나 이동되었을 수 있습니다.<br />
					주소를 다시 확인해주세요.
				</p>
				<a href="/" class="home-button">cd ~</a>
			</div>
		</main>
		<Footer />
	</body>
</html>

