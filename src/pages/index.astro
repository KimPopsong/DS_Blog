---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import GithubActivity from '../components/GithubActivity.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`Home | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 1400px;
				width: 100%;
				margin: 0 auto;
				padding: 4em 2em;
				flex: 1;
			}
			.hero-section {
				margin: 0 auto 5rem auto;
				max-width: 640px;
			}
			.terminal-window {
				background: var(--card-bg);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				overflow: hidden;
			}
			.terminal-titlebar {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.6rem 1rem;
				border-bottom: 1px solid var(--card-border);
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: rgb(var(--gray));
			}
			.terminal-titlebar .dot {
				width: 0.55rem;
				height: 0.55rem;
				border-radius: 50%;
				background: rgb(var(--gray-light));
			}
			.terminal-path {
				margin-left: 0.35rem;
			}
			.terminal-body {
				padding: 1.5rem 1.5rem 1.75rem 1.5rem;
				font-family: var(--font-mono);
				font-size: 0.98rem;
				line-height: 1.9;
			}
			.line {
				margin: 0;
				white-space: pre-wrap;
			}
			.prompt {
				color: var(--accent);
				margin-right: 0.6em;
			}
			.output {
				color: rgb(var(--black));
				margin-bottom: 0.9em;
			}
			.output a {
				color: rgb(var(--gray-dark));
				border-bottom: 1px solid var(--card-border);
			}
			.output a:hover {
				color: var(--accent);
				border-bottom-color: var(--accent);
			}
			.cursor-blink {
				animation: blink 1s step-end infinite;
				color: var(--accent);
			}
			@keyframes blink {
				0%, 100% { opacity: 1; }
				50% { opacity: 0; }
			}
			.activity-card {
				max-width: 780px;
				margin: 0 auto 5rem auto;
				background: var(--card-bg);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				padding: 1.75rem;
			}
			.features-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 1.5rem;
			}
			.feature-card {
				background: var(--card-bg);
				border: 1px solid var(--card-border);
				border-radius: 8px;
				padding: 1.75rem;
				transition: border-color 0.2s ease;
			}
			.feature-card:hover {
				border-color: var(--accent-dim);
			}
			.feature-eyebrow {
				display: block;
				font-family: var(--font-mono);
				font-size: 0.82rem;
				color: var(--accent);
				margin-bottom: 0.75rem;
			}
			.feature-title {
				font-size: 1.15rem;
				margin: 0 0 0.75rem 0;
				color: rgb(var(--black));
			}
			.feature-description {
				color: rgb(var(--gray-dark));
				line-height: 1.7;
				margin: 0;
				font-size: 0.95rem;
			}
			@media (max-width: 1024px) {
				main {
					padding: 3em 1.5em;
				}
			}
			@media (max-width: 720px) {
				main {
					padding: 2em 1em;
				}
				.hero-section {
					margin-bottom: 3.5rem;
				}
				.terminal-body {
					padding: 1.25rem 1.1rem 1.5rem 1.1rem;
					font-size: 0.88rem;
				}
				.features-grid {
					grid-template-columns: 1fr;
					gap: 1.25rem;
				}
				.feature-card {
					padding: 1.5rem;
				}
				.activity-card {
					padding: 1.25rem;
					margin-bottom: 3.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero-section">
				<div class="terminal-window">
					<div class="terminal-titlebar">
						<span class="dot"></span>
						<span class="dot"></span>
						<span class="dot"></span>
						<span class="terminal-path">~/dskim</span>
					</div>
					<div class="terminal-body">
						<p class="line"><span class="prompt">$</span>whoami</p>
						<p class="line output" id="typing-line"><span class="typing-content"></span><span class="cursor-blink">_</span></p>
						<p class="line"><span class="prompt">$</span>ls</p>
						<p class="line output">
							<a href="/blog">blog/</a>&nbsp;&nbsp;<a href="/resume">resume/</a>&nbsp;&nbsp;<a href="/project">project/</a>
						</p>
					</div>
				</div>
			</div>
			<div class="activity-card">
				<GithubActivity username="KimPopsong" />
			</div>
			<div class="features-grid">
				<div class="feature-card">
					<span class="feature-eyebrow">// learning</span>
					<h2 class="feature-title">학습 기록</h2>
					<p class="feature-description">
						백엔드 기술에 대한 학습 내용을 정리하고 기록합니다.
					</p>
				</div>
				<div class="feature-card">
					<span class="feature-eyebrow">// retrospective</span>
					<h2 class="feature-title">프로젝트 회고</h2>
					<p class="feature-description">
						프로젝트를 진행하며 겪은 경험과 배운 점을 회고합니다. 성공과 실패 모두 의미 있는 학습입니다.
					</p>
				</div>
				<div class="feature-card">
					<span class="feature-eyebrow">// troubleshooting</span>
					<h2 class="feature-title">트러블슈팅</h2>
					<p class="feature-description">
						개발 중 마주친 문제들과 해결 과정을 기록합니다. 같은 문제를 겪는 분들에게 도움이 되길 바랍니다.
					</p>
				</div>
			</div>
		</main>
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				const contentEl = document.querySelector('#typing-line .typing-content');
				if (!contentEl) return;
				const fullText = '김대성 — Backend Developer';
				const typingDelayMs = 70;
				const restartDelayMs = 3000;
				let index = 0;
				function typeNext() {
					if (index <= fullText.length) {
						contentEl.textContent = fullText.slice(0, index);
						index += 1;
						setTimeout(typeNext, typingDelayMs);
					} else {
						setTimeout(() => {
							index = 0;
							contentEl.textContent = '';
							typeNext();
						}, restartDelayMs);
					}
				}
				typeNext();
			});
		</script>
		<Footer />
	</body>
</html>
